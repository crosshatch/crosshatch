{
  "name": "crosshatch-root",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "sync-repos": "node ./konfik/main.ts sync-repos",
    "clean": "node ./konfik/main.ts clean --ignore '**/repos'",
    "format": "oxfmt --config ./.oxfmtrc.jsonc --disable-nested-config .",
    "dev": "pnpm i --force && PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false turbo run //#watch //#aliases //#motel dev",
    "aliases": "caddy run --config ./Caddyfile",
    "test": "vitest run",
    "motel": "motel",
    "lint": "oxlint --disable-nested-config --type-aware",
    "crosshatch": "node ./crosshatch/Cli/main.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@crosshatch/alchemy": "workspace:*",
    "@crosshatch/util": "workspace:*",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/expect": "catalog:",
    "@vitest/web-worker": "catalog:",
    "alchemy": "catalog:",
    "crosshatch": "workspace:*",
    "effect": "catalog:",
    "fake-indexeddb": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pkg-pr-new": "catalog:",
    "playwright": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
