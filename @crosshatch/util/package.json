{
  "name": "@crosshatch/util",
  "version": "0.0.5",
  "private": false,
  "description": "Utilities used by various Crosshatch projects.",
  "bugs": {
    "url": "https://github.com/crosshatch/crosshatch/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/crosshatch/crosshatch.git",
    "directory": "@crosshatch/util"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./fonts.css": "./fonts.css",
    "./vocs.css": "./vocs.css",
    ".": "./index.ts",
    "./*": "./*.ts"
  },
  "publishConfig": {
    "exports": {
      "./fonts.css": "./fonts.css",
      "./vocs.css": "./vocs.css",
      ".": "./dist/index.js",
      "./*": "./dist/*.js"
    }
  },
  "peerDependencies": {
    "effect": "catalog:",
    "vocs": "catalog:"
  },
  "peerDependenciesMeta": {
    "vocs": {
      "optional": true
    }
  }
}
