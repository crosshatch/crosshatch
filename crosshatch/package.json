{
  "name": "crosshatch",
  "version": "0.0.15",
  "private": false,
  "description": "Effect x x402",
  "homepage": "https://crosshatch.dev",
  "bugs": {
    "url": "https://github.com/crosshatch/crosshatch/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/crosshatch/crosshatch.git",
    "directory": "packages/crosshatch"
  },
  "bin": {
    "crosshatch": "./dist/Cli/main.js"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts",
    "./*": "./*.ts",
    "./Browser": "./Browser/index.ts",
    "./ChxNodeServices": "./ChxNodeServices/index.ts",
    "./Cirque": "./Cirque/index.ts",
    "./Crypto": "./Crypto/index.ts",
    "./Eip155": "./Eip155/index.ts",
    "./FacilitatorApi": "./FacilitatorApi/index.ts",
    "./Known": "./Known/index.ts",
    "./package.json": "./package.json",
    "./Solana": "./Solana/index.ts",
    "./Unified": "./Unified/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./Browser": "./dist/Browser/index.js",
      "./ChxNodeServices": "./dist/ChxNodeServices/index.js",
      "./Cirque": "./dist/Cirque/index.js",
      "./Crypto": "./dist/Crypto/index.js",
      "./Eip155": "./dist/Eip155/index.js",
      "./FacilitatorApi": "./dist/FacilitatorApi/index.js",
      "./Known": "./dist/Known/index.js",
      "./package.json": "./package.json",
      "./Solana": "./dist/Solana/index.js",
      "./Unified": "./dist/Unified/index.js"
    }
  },
  "scripts": {
    "dev": "node --watch ./Cli/main.ts dev --port 4647 --otel-endpoint http://127.0.0.1:27686"
  },
  "peerDependencies": {
    "@crosshatch/util": "workspace:*",
    "@crosshatch/widget": "workspace:*",
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "@napi-rs/keyring": "catalog:",
    "@scure/bip39": "catalog:",
    "@solana-program/compute-budget": "catalog:",
    "@solana-program/memo": "catalog:",
    "@solana-program/token": "catalog:",
    "@solana/addresses": "catalog:",
    "@solana/kit": "catalog:",
    "@solana/transactions": "catalog:",
    "effect": "catalog:",
    "http-message-sig": "catalog:",
    "ox": "catalog:"
  }
}
